# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (Project Settings > API no painel do Supabase).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-public

# Sem as duas variáveis acima o app roda em "modo local": sem login, com as
# anotações salvas só no navegador. Nome exibido nesse modo:
NEXT_PUBLIC_READER_NAME=André

# Narração (arquivos gerados por scripts/gerar-narracao.py)
# NEXT_PUBLIC_NARRACAO_URL=/narracao
# NEXT_PUBLIC_NARRACAO_VOZ=pt-BR-AntonioNeural
